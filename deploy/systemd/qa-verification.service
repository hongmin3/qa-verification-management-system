# QA 검증 관리 시스템 — 핵심 앱 systemd 유닛
#
# 이 유닛이 없으면 서버가 재부팅됐을 때 앱이 자동으로 뜨지 않는다. 하위 서비스인
# 매뉴얼 서버(qa-manual-hub.service)는 이미 systemd 로 관리되므로, 두 배포 단위의
# 운영 방식을 맞추는 의미도 있다.
#
# 설치 (플레이스홀더를 실제 값으로 바꿔 넣는다):
#
#   sudo sed -e 's|__APP_ROOT__|/path/to/app|' \
#            -e 's|__SERVICE_USER__|ubuntu|' \
#            deploy/systemd/qa-verification.service \
#     | sudo tee /etc/systemd/system/qa-verification.service > /dev/null
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now qa-verification
#
# 이미 nohup 으로 띄워 둔 프로세스가 있으면 먼저 종료해야 포트가 겹치지 않는다.
# 이 유닛은 추가만 한다 — 같은 호스트의 다른 서비스 유닛을 건드리지 않는다.

[Unit]
Description=QA 검증 관리 시스템 (FastAPI/uvicorn)
# nginx 가 이 앱을 / 로 프록시하지만, nginx 가 늦게 떠도 앱은 독립적으로 동작한다.
# 따라서 Requires 가 아니라 After 만 둔다.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__APP_ROOT__
# 포트를 여기 적지 않는다. `app.serve` 가 config.yaml 의 app.host / app.port 를 읽어
# uvicorn 에 넘긴다 — 포트를 바꾸려면 config.yaml 만 고치고 이 유닛은 그대로 둔다.
ExecStart=__APP_ROOT__/.venv/bin/python -m app.serve

# 기존 운영 습관(로그 파일 tail)을 그대로 유지하기 위해 journald 외에 파일에도 남긴다.
StandardOutput=append:__APP_ROOT__/output/logs/uvicorn.out
StandardError=append:__APP_ROOT__/output/logs/uvicorn.out

Restart=on-failure
RestartSec=5s
# 분석 작업이 스레드로 돌기 때문에 종료에 여유를 준다. 앱은 시작 시 끊긴 RUNNING 작업을
# 정리하고 QUEUED 를 이어받으므로, 강제 종료돼도 상태가 깨지지 않는다.
TimeoutStopSec=30s
KillMode=mixed

[Install]
WantedBy=multi-user.target
